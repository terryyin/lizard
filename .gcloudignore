# Deploy only the application, analyzer, shell template, public images and the
# built frontend bundle; never website/frontend (sources, tests, node_modules).
**
!app.yaml
!requirements.txt
!index.py
!lizard.py
!lizard_core/
!lizard_core/**
!lizard_languages/
!lizard_languages/**
!lizard_ext/
!lizard_ext/**
!website/
!website/__init__.py
!website/static/
!website/static/favicon.ico
!website/static/img/
!website/static/img/**
# Generated by `npm --prefix website/frontend run build`; build before deploying.
!website/static/dist/
!website/static/dist/**
!templates/
!templates/**
**/__pycache__/
**/*.pyc
